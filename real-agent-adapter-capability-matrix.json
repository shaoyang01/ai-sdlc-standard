  "safety_boundaries": [
    {
      "name": "no_default_real_model_execution",
      "status": "required",
      "description": "Default execution mode remains shadow"
    },
    {
      "name": "real_adapters_behind_execution_gateway",
      "status": "required",
      "description": "Runtime calls Gateway, not adapters directly"
    },
    {
      "name": "no_runtime_direct_adapter_calls",
      "status": "required",
      "description": "runtime.ts only calls executionGateway.execute()"
    },
    {
      "name": "no_real_sdlc_skill_invocation",
      "status": "required",
      "description": "Adapters execute requests; skills are invoked by future orchestrator"
    },
    {
      "name": "no_file_writes_by_adapters",
      "status": "required",
      "description": "Adapters must not write files to disk"
    },
    {
      "name": "no_git_operations_by_adapters",
      "status": "required",
      "description": "Adapters must not create commits, branches, or PRs"
    },
    {
      "name": "no_secret_logging",
      "status": "required",
      "description": "API keys and full prompts/responses must not be logged"
    },
    {
      "name": "bounded_timeouts",
      "status": "required",
      "description": "All real adapter calls must have configurable timeouts"
    },
    {
      "name": "structured_failures",
      "status": "required",
      "description": "Real adapter failures return structured ExecutionResult"
    },
