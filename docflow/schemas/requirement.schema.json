{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docflow/schemas/requirement.schema.json",
  "title": "DocFlow Requirement Schema",
  "description": "Structured requirement output — pure state machine, no decision logic.",
  "type": "object",
  "required": ["requirement_id", "multi_repo", "main_repo", "sub_requirements"],
  "properties": {
    "requirement_id": { "type": "string" },
    "multi_repo": { "type": "boolean" },
    "main_repo": { "type": "string" },
    "sub_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo", "description"],
        "properties": {
          "repo": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "raw_text": { "type": "string" },
    "parsed_at": { "type": "string", "format": "date-time" }
  }
}
